# Copy this file and fill in real values
# Backend env vars (set these in Render dashboard under Environment Variables)

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_ENCRYPTION_KEY=32-character-random-string-here!!
JWT_SECRET=your-super-secret-jwt-key-here
PORT=3001

TRUID_MERCHANT_ID=your-truid-merchant-id
TRUID_SECRET_KEY=your-truid-secret-key

# Comma-separated list of allowed frontend origins (no trailing slash)
# e.g. https://yourapp.vercel.app,https://yourapp.com
ALLOWED_ORIGINS=http://localhost:3000
